<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="testing"/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="CACHE_DRIVER" value="array"/>
    <!-- ВАЖНО: не удалять/не комментировать эту строку и не указывать
         DB_DATABASE, совпадающий с рабочим fixit_data. RefreshDatabase
         выполняет migrate:fresh на этой БД — если она совпадает с dev/prod,
         тесты стирают реальные данные без предупреждения (см. инцидент
         2026-09-26: тестовый прогон обнулил всю локальную fixit_data).
         pdo_sqlite недоступен в этом окружении, поэтому используется
         отдельная MySQL-база; её нужно один раз создать вручную:
           mysql -uroot -e "CREATE DATABASE fixit_data_testing;
             GRANT ALL PRIVILEGES ON fixit_data_testing.* TO 'fixit'@'127.0.0.1';" -->
    <server name="DB_DATABASE" value="fixit_data_testing"/>
    <server name="MAIL_MAILER" value="array"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
    <server name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
